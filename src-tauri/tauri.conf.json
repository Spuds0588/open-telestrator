{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Telestrator",
  "version": "0.1.0",
  "identifier": "dev.opentelestrator.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:web:dev",
    "beforeBuildCommand": "npm run desktop:web:build",
    "devUrl": "http://localhost:5173/app.html",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "studio",
        "title": "Open Telestrator",
        "url": "app.html",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Video",
    "shortDescription": "Draw over any live video, and stream it out.",
    "longDescription": "A free and open-source sports telestrator. Draw over a capture, bring in cameras and co-hosts, and publish the program to an RTMP platform such as YouTube Live."
  }
}
