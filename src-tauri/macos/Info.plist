<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Info.plist of the macOS download, as a template.

  `bundle.active` is false — there is no installer and no Tauri bundler step — so
  the `.app` the release ships is assembled by hand, by
  `src-tauri/macos/bundle.mjs`, from this file plus the built binary and
  `icons/icon.icns`. The three placeholder values are filled from
  `tauri.conf.json` at that moment, so the version cannot drift from the number a
  running copy compares itself against.

  The point of the bundle is the `NS*UsageDescription` keys. macOS hangs camera,
  microphone and screen-recording permission on the *bundle*: an app with no
  `Info.plist` — which is what a bare executable is — has nowhere for those
  strings to live, so the system refuses the request outright instead of putting
  a dialog on screen. Without this file the two inputs that define the app do not
  work on a Mac at all.

  Run `src-tauri/macos/bundle.mjs` and these strings are all checked before the
  bundle is written; drop one and the release job fails rather than shipping a
  bundle that cannot ask.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>__PRODUCT_NAME__</string>
	<key>CFBundleExecutable</key>
	<string>open-telestrator</string>
	<key>CFBundleIconFile</key>
	<string>icon.icns</string>
	<key>CFBundleIdentifier</key>
	<string>__IDENTIFIER__</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>__PRODUCT_NAME__</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<!-- Tauri's own floor for the macOS shell; see tauri.conf.json. -->
	<key>LSMinimumSystemVersion</key>
	<string>10.13</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!--
	  The camera is the corner camera and the live corner; the microphone carries
	  the program's audio. Screen recording is the other input — the capture the
	  operator draws over — and macOS will not even show its prompt without a
	  string here.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Open Telestrator uses the camera for the live corner and the corner camera you put on air.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Open Telestrator uses the microphone for the program's audio, and to stream it out.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Open Telestrator draws over a screen or window you choose, and can stream that program out.</string>
</dict>
</plist>
